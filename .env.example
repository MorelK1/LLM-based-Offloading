# OpenRouter (https://openrouter.ai) -- default provider for intent_grounding
# and explanation, chosen for reliability over NVIDIA API Catalog.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-5.4-mini

# NVIDIA API Catalog (https://build.nvidia.com) -- kept available via
# utils/llm.py, but not used by default (see README "Known limitations").
NVIDIA_API_KEY=
MISTRAL_MODEL=mistralai/mistral-nemotron
OPENAI_MODEL=openai/gpt-oss-20b
NVIDIA_MODEL=nvidia/nemotron-3-nano-omni-30b-a3b-reasoning
META_MODEL=meta/llama-3.2-11b-vision-instruct
